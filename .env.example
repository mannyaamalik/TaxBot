# ── Embedding ────────────────────────────────────────────────────────────────
# Local sentence-transformer model (used when OPENAI_API_KEY is not set)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Number of text chunks to embed in one forward pass
EMBED_BATCH_SIZE=64

# Set to use the OpenAI-compatible API embedder instead of the local model
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Vector Store ─────────────────────────────────────────────────────────────
# Directory where ChromaDB will persist its data
CHROMA_DB_PATH=./data/chromadb

# ChromaDB collection name
CHROMA_COLLECTION=taxbot_kb

# ── Chunking ─────────────────────────────────────────────────────────────────
# Target token count per chunk (whitespace-split approximation)
CHUNK_SIZE=512

# Token overlap between consecutive chunks
CHUNK_OVERLAP=64

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of chunks returned to the LLM after reranking
RETRIEVAL_TOP_K=5

# Minimum cosine similarity score for a chunk to survive Stage-1 filtering
SIMILARITY_THRESHOLD=0.40

# ── Reranker ──────────────────────────────────────────────────────────────────
# Set to false to skip cross-encoder reranking (saves memory on small machines)
RERANKER_ENABLED=true

# Cross-encoder model for Stage-2 reranking
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Minimum cross-encoder score; chunks below this are discarded after reranking
RERANK_THRESHOLD=0.0

# ── LLM ───────────────────────────────────────────────────────────────────────
# LLM backend: "ollama" (default, local) or "openai" (OpenAI-compatible API)
LLM_PROVIDER=ollama

# Ollama server base URL (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name
OLLAMA_MODEL=llama3

# API key for OpenAI-compatible LLM (used when LLM_PROVIDER=openai)
LLM_API_KEY=

# Base URL for OpenAI-compatible LLM API
LLM_API_BASE_URL=https://api.openai.com/v1

# Model name for OpenAI-compatible LLM
LLM_MODEL=gpt-4o-mini

# Generation temperature — 0 = deterministic
LLM_TEMPERATURE=0.0

# Maximum tokens in LLM response
LLM_MAX_TOKENS=1024

# ── Session ───────────────────────────────────────────────────────────────────
# Number of prior conversation turns to include in the LLM prompt
SESSION_HISTORY_TURNS=5

# Minutes of inactivity before a session is discarded
SESSION_TTL_MINUTES=60

# ── API ───────────────────────────────────────────────────────────────────────
# Requests per minute per IP allowed on POST /chat
RATE_LIMIT_PER_MINUTE=30

# Bearer token required for POST /ingest — MUST be set before running
INGEST_API_KEY=change-me-before-running

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────────
# INFO for production, DEBUG for development
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use * for development; restrict to your domain in production.
# Example: ALLOWED_ORIGINS=https://taxmitra.yourdomain.com
ALLOWED_ORIGINS=*

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Set to your Sentry DSN to enable error tracking and performance monitoring.
SENTRY_DSN=
